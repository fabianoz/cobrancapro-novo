# ============================================
# CobrancaPro - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ---- Billing Provider Selection ----
# Choose: c6 or efi (default: c6)
BILLING_PROVIDER=c6

# ---- C6 Bank BaaS ----
C6_CLIENT_ID=
C6_CLIENT_SECRET=
C6_PFX_BASE64=
C6_PFX_PASSWORD=
C6_SANDBOX=true
C6_BILLING_SCHEME=21
# C6 Beneficiary info (required for boleto creation)
C6_BENEFICIARY_NAME=
C6_BENEFICIARY_DOCUMENT=
C6_BANK_CODE=336
C6_BRANCH=0001
C6_ACCOUNT=
C6_ACCOUNT_DIGIT=

# ---- EFI Bank (Gerencianet) ----
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_PATH=
EFI_PIX_KEY=
EFI_SANDBOX=true

# ---- Banco Inter ----
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_SANDBOX=false

# ---- WhatsApp (Evolution API) ----
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=cobrancapro

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=cobranca@cobrancapro.com.br

# ---- Webhooks ----
WEBHOOK_TOKEN_C6=supersecreto123

# ---- Cron Jobs ----
CRON_SECRET=

# ---- App URL ----
NEXT_PUBLIC_APP_URL=https://cobrancapro.vercel.app
